@page "/lineas-gestion"
@using IVC.Application.Catalogos
@using IVC.Application.Catalogos.Dtos
@inherits IVC.Components.GridPageBase<IVC.Application.Catalogos.Dtos.LineaGestionViewModel>

<PageTitle>Líneas de gestión — IVC</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Líneas de gestión"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar nombre, tipo, grupo o repartición…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 MostrarNuevo="@CanCreate"
                 NuevoDeshabilitado="@_loading"
                 OnNuevo="@AddRow"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros" />

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        <RadzenDataGrid @ref="_grid"
                        Data="@ItemsVisibles"
                        TItem="LineaGestionViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        SettingsChanged="@GuardarSettingsGrilla"
                        LoadSettings="@CargarSettingsGrilla"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="@GridTextos.LimpiarFiltro"
                        ApplyFilterText="@GridTextos.AplicarFiltro"
                        EmptyText="@GridTextos.Vacio"
                        AllowPaging="false"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate"
                        RowCreate="@OnRowCreate">
            <Columns>
                <RadzenDataGridColumn TItem="LineaGestionViewModel" Property="Nombre" Title="Nombre">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Nombre" MaxLength="@LineaGestionValidator.TextoMaxLength"
                                       aria-label="Nombre de la línea"
                                       class="@GetValidationCssClass(!string.IsNullOrWhiteSpace(Buffer(item).Nombre))"
                                       Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LineaGestionViewModel" Property="Tipo" Title="Tipo">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Tipo" MaxLength="@LineaGestionValidator.TextoMaxLength" aria-label="Tipo" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LineaGestionViewModel" Property="Grupo" Title="Grupo">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Grupo" MaxLength="@LineaGestionValidator.TextoMaxLength" aria-label="Grupo" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LineaGestionViewModel" Property="Reparticion" Title="Repartición">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Reparticion" MaxLength="@LineaGestionValidator.TextoMaxLength" aria-label="Repartición" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="LineaGestionViewModel" Title="Acciones" Width="150px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            <AccionesFila MostrarEditar="@CanEdit"
                                          MostrarEliminar="@CanDelete"
                                          OnEditar="@(() => _grid.EditRow(item))"
                                          OnEliminar="@(() => DeleteRow(item))"
                                          OnHistorial="@(() => VerHistorial(item))" />
                        </Template>
                        <EditTemplate Context="item">
                            <AccionesFila Edicion="true"
                                          OnGuardar="@(() => GuardarFila(item))"
                                          OnCancelar="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)" TotalFilas="@_items.Count" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>
