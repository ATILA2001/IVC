@page "/redeterminaciones"
@using IVC.Application.Common
@using IVC.Application.Redeterminaciones
@using IVC.Application.Redeterminaciones.Dtos
@inherits IVC.Components.GridPageBase<IVC.Application.Redeterminaciones.Dtos.RedeterminacionViewModel>

<PageTitle>Redeterminaciones — IVC</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Redeterminaciones"
                 SizeTitulo="3"
                 SizeAcciones="9"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar código, obra, empresa, etapa, expediente, tipo o usuario…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos && !HayFiltrosEspeciales)"
                 MostrarNuevo="@(CanCreate && _puedeModificar)"
                 NuevoDeshabilitado="@(_loading || _autorizantes.Count == 0)"
                 OnNuevo="@NuevoEnVentana"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarTodo">
        <Acciones>
            @* Filtros especiales del legado: control de estados (buzón que no corresponde a la etapa) y días en buzón. *@
            <RadzenDropDown TValue="SeguimientoBuzon.Rango" @bind-Value="_rangoDias" Data="@RangosDias"
                            TextProperty="Texto" ValueProperty="Valor" aria-label="Días en buzón" Style="width: 190px" />
            <RadzenCheckBox TValue="bool" @bind-Value="_soloDiscrepancias" Name="chkDiscrepancias" />
            <RadzenLabel Text="Control de estados" Component="chkDiscrepancias" title="Sólo las redeterminaciones cuyo buzón SADE no corresponde a la etapa" />
        </Acciones>
    </GridToolbar>

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        <RadzenDataGrid @ref="_grid"
                        Data="@FilasVisibles"
                        TItem="RedeterminacionViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        SettingsChanged="@GuardarSettingsGrilla"
                        LoadSettings="@CargarSettingsGrilla"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="@GridTextos.LimpiarFiltro"
                        ApplyFilterText="@GridTextos.AplicarFiltro"
                        EmptyText="@GridTextos.Vacio"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate">
            <Columns>
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="CodigoRedet" Title="Código" Width="150px" Frozen="true">
                    <Template Context="item">
                        @if (item.Discrepancia)
                        {
                            <RadzenIcon Icon="warning" Style="font-size: 1rem; vertical-align: middle; color: var(--rz-warning);" title="El buzón SADE no corresponde a la etapa" />
                        }
                        @item.CodigoRedet
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Obra" Title="Obra" Width="240px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Empresa" Title="Empresa" Width="160px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Contrata" Title="Contrata" Width="140px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Area" Title="Área" Width="120px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Etapa" Title="Etapa" Width="220px">
                    <EditTemplate Context="item">
                        <RadzenDropDown TValue="int?" @bind-Value="Buffer(item).EtapaId" Data="@_etapas"
                                        TextProperty="@nameof(OpcionLookup.Nombre)" ValueProperty="@nameof(OpcionLookup.Id)"
                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        aria-label="Etapa" class="@GetValidationCssClass(Buffer(item).EtapaId is > 0)" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Expediente" Title="Expediente" Width="200px">
                    <EditTemplate Context="item">
                        <RadzenTextBox @bind-Value="Buffer(item).Expediente" MaxLength="@RedeterminacionValidator.ExpedienteMaxLength"
                                       aria-label="Expediente" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Tipo" Title="Tipo" Width="120px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Salto" Title="Salto" Width="100px" FormatString="{0:MM/yyyy}" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Nro" Title="Nro" Width="70px" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Porcentaje" Title="Porcentaje" Width="110px" FormatString="{0:N2} %" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Observaciones" Title="Observaciones" Width="220px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="Usuario" Title="Usuario" Width="150px">
                    <EditTemplate Context="item">
                        <RadzenDropDown TValue="int?" Value="@(Buffer(item).UsuarioId ?? 0)" ValueChanged="@((int? v) => Buffer(item).UsuarioId = v is > 0 ? v : null)"
                                        Data="@_usuariosConVacio"
                                        TextProperty="@nameof(OpcionLookup.Nombre)" ValueProperty="@nameof(OpcionLookup.Id)"
                                        aria-label="Usuario" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="BuzonSade" Title="Buzón SADE" Width="220px" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="FechaSade" Title="Fecha SADE" Width="120px" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="RedeterminacionViewModel" Property="DiasEnBuzon" Title="Días en buzón" Width="110px" TextAlign="TextAlign.Right">
                    <Template Context="item">
                        @if (item.DiasEnBuzon is int dias)
                        {
                            <span style="font-weight: 700; color: @ColorDias(dias);">@dias</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="RedeterminacionViewModel" Title="Acciones" Width="190px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            <AccionesFila MostrarEditar="@(CanEdit && _puedeModificar)"
                                          MostrarEliminar="@(CanDelete && _puedeModificar)"
                                          OnEditar="@(() => _grid.EditRow(item))"
                                          OnEditarEnVentana="@(CanEdit && _puedeModificar ? EventCallback.Factory.Create(this, () => EditarEnVentana(item)) : default)"
                                          OnEliminar="@(() => DeleteRow(item))"
                                          OnHistorial="@(() => VerHistorial(item))" />
                        </Template>
                        <EditTemplate Context="item">
                            <AccionesFila Edicion="true"
                                          OnGuardar="@(() => GuardarFila(item))"
                                          OnCancelar="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)" TotalFilas="@_items.Count" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>
