@page "/autorizantes"
@using IVC.Application.Common
@using IVC.Application.Redeterminaciones
@using IVC.Application.Redeterminaciones.Dtos
@inherits IVC.Components.GridPageBase<IVC.Application.Redeterminaciones.Dtos.AutorizanteViewModel>

<PageTitle>Autorizantes — IVC</PageTitle>

<RadzenStack>
    <GridToolbar Titulo="Autorizantes"
                 SizeTitulo="3"
                 SizeAcciones="9"
                 OnBuscar="@OnBusquedaChanged"
                 TextoBusqueda="@_textoBusqueda"
                 PlaceholderBusqueda="Buscar obra, código, expediente, detalle, empresa, concepto o estado…"
                 LimpiarFiltrosDeshabilitado="@(!HayFiltrosActivos)"
                 MostrarNuevo="@(CanCreate && _puedeModificar)"
                 NuevoDeshabilitado="@(_loading || _obras.Count == 0)"
                 OnNuevo="@NuevoEnVentana"
                 Exportando="@_exportando"
                 ExportarDeshabilitado="@ExportarDeshabilitado"
                 TituloExportarDeshabilitado="@MotivoExportarDeshabilitado"
                 OnExportar="@ExportarExcel"
                 OnLimpiarFiltros="@LimpiarFiltros" />

    @if (_loading)
    {
        <EstadoCarga Texto="@($"Cargando {TituloEntidad}…")" />
    }
    else
    {
        <RadzenDataGrid @ref="_grid"
                        Data="@ItemsVisibles"
                        TItem="AutorizanteViewModel"
                        Filter="@OnGridFilter"
                        FilterCleared="@OnGridFilter"
                        SettingsChanged="@GuardarSettingsGrilla"
                        LoadSettings="@CargarSettingsGrilla"
                        AllowFiltering="true"
                        AllowSorting="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.CheckBoxList"
                        ClearFilterText="@GridTextos.LimpiarFiltro"
                        ApplyFilterText="@GridTextos.AplicarFiltro"
                        EmptyText="@GridTextos.Vacio"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        Style="height: calc(100vh - 15rem)"
                        EditMode="DataGridEditMode.Single"
                        RowEdit="@OnRowEdit"
                        RowUpdate="@OnRowUpdate">
            <Columns>
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Obra" Title="Obra" Width="260px" Frozen="true" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="CodigoAutorizante" Title="Código" Width="140px" Frozen="true">
                    <Template Context="item">
                        @if (item.EsRedeterminacion)
                        {
                            <span title="Redeterminación (fila calculada, se edita en Redeterminaciones)">@item.CodigoAutorizante <RadzenIcon Icon="price_change" Style="font-size: 1rem; vertical-align: middle; color: var(--rz-text-secondary-color);" /></span>
                        }
                        else
                        {
                            @item.CodigoAutorizante
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Area" Title="Área" Width="130px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Contrata" Title="Contrata" Width="150px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Empresa" Title="Empresa" Width="170px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Barrio" Title="Barrio" Width="140px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Expediente" Title="Expediente" Width="200px">
                    <EditTemplate Context="item">
                        @if (item.EsRedeterminacion)
                        {
                            @item.Expediente
                        }
                        else
                        {
                            <RadzenTextBox @bind-Value="Buffer(item).Expediente" MaxLength="@AutorizanteValidator.ExpedienteMaxLength"
                                           aria-label="Expediente" Style="width:100%" />
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Detalle" Title="Detalle" Width="240px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Concepto" Title="Concepto" Width="150px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="MontoAutorizado" Title="Monto autorizado" Width="150px" FormatString="{0:N2}" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="MesAprobacion" Title="Mes aprobación" Width="120px" FormatString="{0:MM/yyyy}" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="MesBase" Title="Mes base" Width="110px" FormatString="{0:MM/yyyy}" Visible="@_veSeguimiento" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Estado" Title="Estado" Width="160px">
                    <EditTemplate Context="item">
                        @if (item.EsRedeterminacion)
                        {
                            @item.Estado
                        }
                        else
                        {
                            <RadzenDropDown TValue="int?" @bind-Value="Buffer(item).EstadoId" Data="@_estados"
                                            TextProperty="@nameof(OpcionLookup.Nombre)" ValueProperty="@nameof(OpcionLookup.Id)"
                                            aria-label="Estado" class="@GetValidationCssClass(Buffer(item).EstadoId is > 0)" Style="width:100%" />
                        }
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="BuzonSade" Title="Buzón SADE" Width="220px" Visible="@_veSeguimiento" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="FechaSade" Title="Fecha SADE" Width="120px" FormatString="{0:dd/MM/yyyy}" Visible="@_veSeguimiento" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="Acdir" Title="GEDO" Width="170px" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="EjecFisica" Title="Ejec. física (%)" Width="120px" FormatString="{0:N2} %" TextAlign="TextAlign.Right" />
                <RadzenDataGridColumn TItem="AutorizanteViewModel" Property="FaltanteEjecFisica" Title="Faltante fís. (%)" Width="120px" FormatString="{0:N2} %" TextAlign="TextAlign.Right" />
                @if (CanEdit || CanDelete || CanCreate)
                {
                    <RadzenDataGridColumn TItem="AutorizanteViewModel" Title="Acciones" Width="190px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @* Las filas virtuales (redeterminaciones) se editan en su propia página. *@
                            @if (!item.EsRedeterminacion)
                            {
                                <AccionesFila MostrarEditar="@(CanEdit && _puedeInline)"
                                              MostrarEliminar="@(CanDelete && _puedeModificar)"
                                              OnEditar="@(() => _grid.EditRow(item))"
                                              OnEditarEnVentana="@(CanEdit && _puedeModificar ? EventCallback.Factory.Create(this, () => EditarEnVentana(item)) : default)"
                                              OnEliminar="@(() => DeleteRow(item))"
                                              OnHistorial="@(() => VerHistorial(item))" />
                            }
                        </Template>
                        <EditTemplate Context="item">
                            <AccionesFila Edicion="true"
                                          OnGuardar="@(() => GuardarFila(item))"
                                          OnCancelar="@(() => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }
            </Columns>
            <FooterTemplate>
                <GridFooterTotales Filas="@(_grid?.View?.Count() ?? 0)"
                                   TotalFilas="@_items.Count"
                                   Importe="@(_grid?.View?.Sum(x => x.MontoAutorizado ?? 0m) ?? 0m)" />
            </FooterTemplate>
        </RadzenDataGrid>
    }
</RadzenStack>
