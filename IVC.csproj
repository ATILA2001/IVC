<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-IVC-3f6c1d2a-8b4e-4c7a-9e21-5d0f7a1b6c93</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Radzen.Blazor" Version="10.3.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <!-- El proyecto de tests vive debajo de esta carpeta: excluirlo del build web. -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
    <EmbeddedResource Remove="Tests\**\*" />
    <Content Remove="Tests\**\*" />
  </ItemGroup>

  <!-- Archivos de pistas Razor que genera el IDE. -->
  <ItemGroup>
    <Compile Remove="**\*.razor.*.ide.g.cs" />
  </ItemGroup>

  <!-- Única fuente de verdad del DTO de la cookie compartida (igual que SAF y SAI):
       si Auth.Web cambia la estructura, este proyecto deja de compilar en vez de
       fallar en silencio al deserializar la cookie. Requiere el repo Auth.Web al lado. -->
  <ItemGroup>
    <Compile Include="..\Auth.Web\Security\SharedCookieTicketDto.cs"
             Link="Security\SharedCookieTicketDto.cs" />
  </ItemGroup>

</Project>
